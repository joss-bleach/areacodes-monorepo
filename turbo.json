{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "!.output/cache/**", ".vercel/output/**", "dist/**"],
      "env": [
        "CLERK_SECRET_KEY",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_CLERK_SIGN_IN_URL",
        "VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
        "VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
        "VITE_CONVEX_URL",
        "CONVEX_DEPLOY_KEY",
        "GEOAPIFY_API_KEY"
      ]
    },
    "convex:generate": {
      "inputs": ["packages/convex/convex/**/*.ts"],
      "outputs": ["packages/convex/convex/_generated/**"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "convex:generate"]
    },
    "test": {
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
