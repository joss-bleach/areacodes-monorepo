{
  "name": "areacodes-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "convex:generate": "turbo run convex:generate",
    "test": "turbo run test --filter=!e2e",
    "test:e2e": "turbo run test:e2e",
    "sandcastle": "bun .sandcastle/main.mts"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "prettier": "^3.6.2",
    "shadcn": "^3.8.5",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@ai-hero/sandcastle": "^0.8.0",
    "nuqs": "^2.7.2",
    "zod": "^4.1.12"
  }
}
