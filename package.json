{
  "name": "areacodes-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:check": "turbo run db:check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:update-slugs": "turbo run db:update-slugs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@clerk/nextjs": "^6.34.0",
    "@supabase/supabase-js": "^2.76.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.5",
    "@trpc/client": "^11.7.0",
    "@trpc/server": "^11.7.0",
    "@trpc/tanstack-react-query": "^11.7.0",
    "bun": "^1.3.1",
    "client-only": "^0.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "nuqs": "^2.7.2",
    "postgres": "^3.4.7",
    "react-error-boundary": "^6.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.3",
    "zod": "^4.1.12"
  }
}
