---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Button } from "@repo/ui";

const ogAltText = "Person in an orange shirt serving steaming noodles into a tray at a food stall, with people in the background. Text overlay reads: \"Find exclusive offers supporting independent businesses.\"";
---

<BaseLayout
	title="Areacodes - Support Local. Spend Less."
	description="Exclusive offers supporting independent businesses."
	ogImageAlt={ogAltText}
>
	<!-- Hero Section -->
	<section class="relative">
		<div class="h-[90dvh] overflow-y-hidden">
			<!-- Mobile video (sm) -->
			<video
				src="/video/ac-hero-sm.mp4"
				class="relative -z-10 block md:hidden h-full w-full object-cover"
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				aria-label="Hero video showing local businesses"
			></video>
			<!-- Tablet video (md) -->
			<video
				src="/video/ac-hero-md.mp4"
				class="relative -z-10 hidden md:block lg:hidden h-full w-full object-cover"
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				aria-label="Hero video showing local businesses"
			></video>
			<!-- Desktop video (lg) -->
			<video
				src="/video/ac-hero-lg.mp4"
				class="relative -z-10 hidden lg:block h-full w-full object-cover"
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				aria-label="Hero video showing local businesses"
			></video>
		</div>
		<div class="absolute top-0 left-0 flex h-[90dvh] w-full items-center">
			<div class="mx-auto w-[87.5%] md:w-[692px] lg:w-[980px]">
				<div class="flex max-w-md md:max-w-lg lg:max-w-2xl flex-col gap-2">
					<h1 class="inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-black text-white text-[40px] md:text-[64px] lg:text-[80px] leading-none">
						Support Local. Spend Less.
					</h1>
					<h2 class="inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-black text-white text-[19px] md:text-[24px] lg:text-[28px] leading-none">
						Exclusive offers supporting independent businesses.
					</h2>
					<div class="pt-2">
						<Button client:load className="w-full md:w-[180px] bg-white p-6 font-semibold tracking-wide text-black shadow-none hover:cursor-pointer hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2">
							View map
						</Button>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- End hero section -->

	<!-- How it works section -->
	<section class="bg-black py-[60px] md:py-[100px]">
		<div class="mx-auto w-[87.5%] md:w-[692px] lg:w-[980px]">
			<h2 class="index-reveal inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-white text-black text-[28px] md:text-[36px] lg:text-[48px] leading-none">
				How it works
			</h2>
			<div class="mt-[40px] md:mt-[60px] grid grid-cols-1 md:grid-cols-3 gap-[40px]">
				<div class="index-reveal" style="--reveal-delay: 0.1s;">
					<div class="aspect-[3/2] overflow-hidden rounded-sm">
						<img
							src="/images/how-it-works-01.jpg"
							alt="Street food market with local vendors"
							class="h-full w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<span class="mt-4 inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-white text-black text-[14px] leading-none">
						01
					</span>
					<h3 class="mt-4 text-white font-bold text-[19px] md:text-[22px] uppercase tracking-tight">
						Explore the map
					</h3>
					<p class="mt-3 text-white/80 text-base leading-relaxed">
						Every pin is an independent business waiting to be discovered. See the city at a glance.
					</p>
				</div>
				<div class="index-reveal" style="--reveal-delay: 0.2s;">
					<div class="aspect-[3/2] overflow-hidden rounded-sm">
						<img
							src="/images/how-it-works-02.jpg"
							alt="Customer redeeming a voucher at a local shop counter"
							class="h-full w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<span class="mt-4 inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-white text-black text-[14px] leading-none">
						02
					</span>
					<h3 class="mt-4 text-white font-bold text-[19px] md:text-[22px] uppercase tracking-tight">
						Grab a voucher
					</h3>
					<p class="mt-3 text-white/80 text-base leading-relaxed">
						Find exclusive deals from the businesses you love. No catch, no corporate middlemen.
					</p>
				</div>
				<div class="index-reveal" style="--reveal-delay: 0.3s;">
					<div class="aspect-[3/2] overflow-hidden rounded-sm">
						<img
							src="/images/how-it-works-03.jpg"
							alt="Customer chatting with a shopkeeper at a local business"
							class="h-full w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<span class="mt-4 inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-white text-black text-[14px] leading-none">
						03
					</span>
					<h3 class="mt-4 text-white font-bold text-[19px] md:text-[22px] uppercase tracking-tight">
						Support locals
					</h3>
					<p class="mt-3 text-white/80 text-base leading-relaxed">
						Show your voucher, save money, and put it straight back into your neighbourhood.
					</p>
				</div>
			</div>
		</div>
	</section>
	<!-- End how it works section -->

	<!-- CTA section -->
	<section class="bg-white py-[60px] md:py-[100px]">
		<div class="mx-auto w-[87.5%] md:w-[692px] lg:w-[980px]">
			<div class="index-reveal grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center" style="--reveal-delay: 0.15s;">
				<div class="flex flex-col items-start gap-6">
					<h2 class="inline-block w-fit px-2 py-1 font-bold uppercase tracking-tight bg-black text-white text-[28px] md:text-[36px] lg:text-[48px] leading-none">
						Join the movement
					</h2>
					<p class="max-w-md text-black text-base leading-relaxed">
						Backing Brighton's independents doesn't have to mean paying more. Support local and spend less today.
					</p>
					<a href="https://map.acbrighton.com">
						<Button client:load className="w-full md:w-[200px] bg-black p-6 font-semibold tracking-wide text-white shadow-none hover:bg-black/90 focus-visible:outline-2 focus-visible:outline-black focus-visible:outline-offset-2 active:scale-[0.98] transition-transform">
							Explore the map
						</Button>
					</a>
				</div>
				<div class="aspect-[4/3] overflow-hidden rounded-sm">
					<img
						src="/images/cta-join.jpg"
						alt="Vibrant food truck row at a local market"
						class="h-full w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</section>
	<!-- End CTA section -->
</BaseLayout>

<style>
	.index-reveal {
		opacity: 0;
		transform: translateY(12px);
		animation: indexReveal 0.5s ease-out forwards;
		animation-delay: var(--reveal-delay, 0s);
	}

	@keyframes indexReveal {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
