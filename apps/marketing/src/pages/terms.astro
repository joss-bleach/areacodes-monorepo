<style>
	article {
		color: #000;
	}

	article h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
		margin-top: 0;
		line-height: 1.2;
	}

	article h2 {
		font-size: 1.875rem;
		font-weight: 600;
		margin-top: 2rem;
		margin-bottom: 1rem;
		line-height: 1.3;
	}

	article h3 {
		font-size: 1.5rem;
		font-weight: 600;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
		line-height: 1.4;
	}

	article h4 {
		font-size: 1.25rem;
		font-weight: 600;
		margin-top: 1.25rem;
		margin-bottom: 0.5rem;
		line-height: 1.5;
	}

	article p {
		margin-bottom: 1rem;
		line-height: 1.75;
	}

	article ul,
	article ol {
		margin-bottom: 1rem;
		padding-left: 1.5rem;
	}

	article li {
		margin-bottom: 0.5rem;
		line-height: 1.75;
	}

	article a {
		color: #000;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	article a:hover {
		opacity: 0.8;
	}

	article code {
		background-color: #f3f4f6;
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
		font-family: ui-monospace, monospace;
	}

	article strong {
		font-weight: 600;
	}
</style>
