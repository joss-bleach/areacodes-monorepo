{
  "extends": "@repo/typescript-config/react-native.json",
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./app/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "app/**/*",
    "nativewind-env.d.ts",
    "env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
