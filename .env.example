# ── Convex ────────────────────────────────────────────────────────────────────
CONVEX_DEPLOY_KEY=

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=

# ── Square OAuth (sandbox) ────────────────────────────────────────────────────
# Register a sandbox app at https://developer.squareup.com/apps
# Set the OAuth Redirect URL in the Square Developer Dashboard to:
#   {VITE_CONVEX_SITE_URL}/square/callback
SQUARE_APP_ID=sandbox-sq0idb-...
SQUARE_APP_SECRET=sandbox-sq0csb-...
SQUARE_OAUTH_REDIRECT_URI=https://your-convex-site.convex.site/square/callback

# Sandbox base URL (switch to https://connect.squareup.com for production)
SQUARE_BASE_URL=https://connect.squareupsandbox.com

# ── Token encryption (AES-256-GCM) ───────────────────────────────────────────
# 32-byte key, base64-encoded. Generate with:
#   openssl rand -base64 32
# Never commit the real value. Rotate by incrementing the key version in code.
TOKEN_ENCRYPTION_KEY=

# ── Business app URL (used in OAuth redirects) ────────────────────────────────
BUSINESS_APP_URL=http://localhost:5173

# ── Client-side env vars (prefix with VITE_) ─────────────────────────────────
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Square App ID is also needed client-side to construct the OAuth URL
VITE_SQUARE_APP_ID=sandbox-sq0idb-...
